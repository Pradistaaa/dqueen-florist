---
// src/components/Rekanan.astro
import { rekanan } from "../data/rekanan";
---
<section id="rekanan" class="sec">
  <h2>Rekanan kami</h2>
  <p class="sub">Brand, perusahaan, dan instansi yang pernah memesan di dQueen Florist.</p>
  <ul class="logos">
    {rekanan.map((r) => (
      <li class="tile">
        <img
          src={`/img/rekanan/${r.logo}`}
          alt={`Logo ${r.nama}`}
          loading="lazy"
          onerror="this.parentElement.classList.add('tanpa-logo')"
        />
        <span class="nama">{r.nama}</span>
        {r.ket && <span class="ket">{r.ket}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .logos{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
  .tile{display:flex;flex-direction:column;align-items:center;gap:6px;padding:20px 14px 14px;background:#f6f2e9;border:1px solid var(--line);border-radius:12px}
  .tile img{width:100%;height:56px;object-fit:contain;margin-bottom:4px}
  .nama{display:none;font-size:.84rem;line-height:1.3;text-align:center;color:#4a4338}
  .ket{font-size:.74rem;line-height:1.3;text-align:center;color:#7a705e}
  /* kalau file logo belum ada: tampilkan nama saja */
  .tile.tanpa-logo{justify-content:center;min-height:112px}
  .tile.tanpa-logo img{display:none}
  .tile.tanpa-logo .nama{font-family:"Cormorant Garamond",Georgia,serif;font-size:1.3rem;font-weight:600;color:#16120a}
  @media (max-width:860px){
    .logos{grid-template-columns:repeat(2,1fr);gap:10px}
    .tile{padding:16px 10px 12px}
    .tile img{height:48px}
  }
</style>
